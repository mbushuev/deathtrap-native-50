#include <windows.h>
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/setup.manifest"
101 RCDATA "@PAYLOAD_FILE@"
1 VERSIONINFO
 FILEVERSION @VERSION_COMMAS@,0
 PRODUCTVERSION @VERSION_COMMAS@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Deathtrap Native 50 Setup"
   VALUE "FileVersion", "@NATIVE50_VERSION@"
   VALUE "ProductName", "Deathtrap Native 50"
   VALUE "ProductVersion", "@NATIVE50_VERSION@"
   VALUE "OriginalFilename", "Native50Setup.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
