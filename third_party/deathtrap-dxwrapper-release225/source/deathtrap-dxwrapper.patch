+void m_IDirect3DDeviceX::DumpTexture(UINT Stage, m_IDirectDrawSurfaceX* TextureSurface, IDirect3DTexture9* DrawTexture, bool ColorKey)
+{
+	if (!Config.DdrawDumpTextures || !TextureSurface || !DrawTexture || !D3DXSaveTextureToFileInMemory)
+	{
+		return;
+	}
+
+	static std::vector<const m_IDirectDrawSurfaceX*> SeenSurfaces;
+	if (std::find(SeenSurfaces.begin(), SeenSurfaces.end(), TextureSurface) != SeenSurfaces.end())
+	{
+		return;
+	}
+	SeenSurfaces.push_back(TextureSurface);
+
+	D3DSURFACE_DESC Desc = {};
+	if (FAILED(DrawTexture->GetLevelDesc(0, &Desc)))
+	{
+		return;
+	}
+
+	ComPtr<ID3DXBuffer> Buffer;
+	const HRESULT DumpResult = D3DXSaveTextureToFileInMemory(Buffer.GetAddressOf(), D3DXIFF_PNG, DrawTexture, nullptr);
+	if (FAILED(DumpResult) || !Buffer || !Buffer->GetBufferPointer() || !Buffer->GetBufferSize())
+	{
+		Logging::Log() << "TextureDump failed tex=" << TextureSurface << " hr=" << (D3DERR)DumpResult;
+		return;
+	}
+
+	const BYTE* Bytes = static_cast<const BYTE*>(Buffer->GetBufferPointer());
+	const SIZE_T ByteCount = Buffer->GetBufferSize();
+	UINT64 Hash = 1469598103934665603ull;
+	for (SIZE_T i = 0; i < ByteCount; ++i)
+	{
+		Hash ^= Bytes[i];
+		Hash *= 1099511628211ull;
+	}
+	Hash ^= Desc.Width;
+	Hash *= 1099511628211ull;
+	Hash ^= Desc.Height;
+	Hash *= 1099511628211ull;
+	Hash ^= static_cast<DWORD>(Desc.Format);
+	Hash *= 1099511628211ull;
+
+	char ExePath[MAX_PATH] = {};
+	if (!GetModuleFileNameA(nullptr, ExePath, MAX_PATH))
+	{
+		return;
+	}
+	if (char* Slash = strrchr(ExePath, '\\'))
+	{
+		*Slash = '\0';
+	}
+
+	char DumpDirectory[MAX_PATH] = {};
+	sprintf_s(DumpDirectory, "%s\\texture-dump", ExePath);
+	CreateDirectoryA(DumpDirectory, nullptr);
+
+	char HashText[32] = {};
+	sprintf_s(HashText, "%016llX", Hash);
+	char DumpPath[MAX_PATH] = {};
+	sprintf_s(DumpPath, "%s\\tex-%s-%ux%u-fmt%u.png", DumpDirectory, HashText, Desc.Width, Desc.Height, static_cast<UINT>(Desc.Format));
+
+	const bool NewFile = (GetFileAttributesA(DumpPath) == INVALID_FILE_ATTRIBUTES);
+	if (NewFile)
+	{
+		std::ofstream Output(DumpPath, std::ios::binary | std::ios::out);
+		if (Output.is_open())
+		{
+			Output.write(static_cast<const char*>(Buffer->GetBufferPointer()), Buffer->GetBufferSize());
+		}
+	}
+
+	char ManifestPath[MAX_PATH] = {};
+	sprintf_s(ManifestPath, "%s\\manifest.csv", DumpDirectory);
+	const bool NewManifest = (GetFileAttributesA(ManifestPath) == INVALID_FILE_ATTRIBUTES);
+	std::ofstream Manifest(ManifestPath, std::ios::out | std::ios::app);
+	if (Manifest.is_open())
+	{
+		if (NewManifest)
+		{
+			Manifest << "hash,file,width,height,format,color_key,has_alpha,stage,png_bytes\n";
+		}
+		Manifest << HashText << ",tex-" << HashText << "-" << Desc.Width << "x" << Desc.Height << "-fmt" << static_cast<UINT>(Desc.Format) << ".png,"
+			<< Desc.Width << "," << Desc.Height << "," << static_cast<UINT>(Desc.Format) << "," << ColorKey << ","
+			<< TextureSurface->HasAlphaChannel(ColorKey) << "," << Stage << "," << ByteCount << "\n";
+	}
+
+	Logging::Log() << "TextureDump " << (NewFile ? "saved" : "seen") << " tex=" << TextureSurface << " hash=" << HashText << " size=" << Desc.Width << "x" << Desc.Height
+		<< " fmt=" << Desc.Format << " ckey=" << ColorKey << " stage=" << Stage;
+}
