+namespace DdrawWrapper
+{
+	using DeathtrapWidescreenWorldRenderActiveFn = BOOL(WINAPI*)();
+	using DeathtrapWidescreenAspectX1000Fn = DWORD(WINAPI*)();
+
+	bool IsDeathtrapWidescreenWorldRenderActive()
+	{
+		static DeathtrapWidescreenWorldRenderActiveFn Query = nullptr;
+		if (!Query)
+		{
+			if (HMODULE Dinput = GetModuleHandleW(L"DINPUT.dll"))
+			{
+				Query = reinterpret_cast<DeathtrapWidescreenWorldRenderActiveFn>(
+					GetProcAddress(Dinput, "DeathtrapWidescreenWorldRenderActive"));
+			}
+		}
+		return Query && Query();
+	}
+
+	DWORD GetDeathtrapWidescreenAspectX1000()
+	{
+		if (Config.DdrawWidescreenAspectX1000 == 0)
+		{
+			return 0;
+		}
+		if (Config.DdrawWidescreenAspectX1000 > 1)
+		{
+			return min(Config.DdrawWidescreenAspectX1000, 3000ul);
+		}
+
+		static DeathtrapWidescreenAspectX1000Fn Query = nullptr;
+		if (!Query)
+		{
+			if (HMODULE Dinput = GetModuleHandleW(L"DINPUT.dll"))
+			{
+				Query = reinterpret_cast<DeathtrapWidescreenAspectX1000Fn>(
+					GetProcAddress(Dinput, "DeathtrapWidescreenAspectX1000"));
+			}
+		}
+		if (Query)
+		{
+			const DWORD AspectX1000 = Query();
+			if (AspectX1000)
+			{
+				return min(AspectX1000, 3000ul);
+			}
+		}
+
+		HWND Window = Utils::GetMainWindowForProcess(GetCurrentProcessId());
+		HMONITOR Monitor = MonitorFromWindow(Window,
+			Window ? MONITOR_DEFAULTTONEAREST : MONITOR_DEFAULTTOPRIMARY);
+		MONITORINFO MonitorInfo = {};
+		MonitorInfo.cbSize = sizeof(MonitorInfo);
+		if (Monitor && GetMonitorInfoW(Monitor, &MonitorInfo))
+		{
+			const LONG Width = MonitorInfo.rcMonitor.right - MonitorInfo.rcMonitor.left;
+			const LONG Height = MonitorInfo.rcMonitor.bottom - MonitorInfo.rcMonitor.top;
+			if (Width > 0 && Height > 0)
+			{
+				return min(static_cast<DWORD>((static_cast<ULONGLONG>(Width) * 1000 + Height / 2) / Height), 3000ul);
+			}
+		}
+		return 0;
+	}
+}
