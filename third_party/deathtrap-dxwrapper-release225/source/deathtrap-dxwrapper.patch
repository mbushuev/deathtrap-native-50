+void m_IDirect3DDeviceX::TraceAlphaDraw(const char* DrawKind, D3DPRIMITIVETYPE PrimitiveType, DWORD VertexTypeDesc, DWORD VertexCount, const void* Vertices)
+{
+	if (!Config.DdrawTraceAlphaDraws || !d3d9Device || !*d3d9Device)
+	{
+		return;
+	}
+
+	DWORD AlphaBlend = FALSE;
+	DWORD SrcBlend = D3DBLEND_ONE;
+	DWORD DestBlend = D3DBLEND_ZERO;
+	DWORD AlphaTest = FALSE;
+	DWORD AlphaFunc = D3DCMP_ALWAYS;
+	DWORD AlphaRef = 0;
+	DWORD ZWrite = TRUE;
+	DWORD ZEnable = TRUE;
+	DWORD ColorOp = D3DTOP_DISABLE;
+	DWORD AlphaOp = D3DTOP_DISABLE;
+	DWORD MinFilter = D3DTEXF_NONE;
+	DWORD MagFilter = D3DTEXF_NONE;
+	DWORD MipFilter = D3DTEXF_NONE;
+
+	(*d3d9Device)->GetRenderState(D3DRS_ALPHABLENDENABLE, &AlphaBlend);
+	(*d3d9Device)->GetRenderState(D3DRS_SRCBLEND, &SrcBlend);
+	(*d3d9Device)->GetRenderState(D3DRS_DESTBLEND, &DestBlend);
+	(*d3d9Device)->GetRenderState(D3DRS_ALPHATESTENABLE, &AlphaTest);
+	(*d3d9Device)->GetRenderState(D3DRS_ALPHAFUNC, &AlphaFunc);
+	(*d3d9Device)->GetRenderState(D3DRS_ALPHAREF, &AlphaRef);
+	(*d3d9Device)->GetRenderState(D3DRS_ZWRITEENABLE, &ZWrite);
+	(*d3d9Device)->GetRenderState(D3DRS_ZENABLE, &ZEnable);
+	(*d3d9Device)->GetTextureStageState(0, D3DTSS_COLOROP, &ColorOp);
+	(*d3d9Device)->GetTextureStageState(0, D3DTSS_ALPHAOP, &AlphaOp);
+	(*d3d9Device)->GetSamplerState(0, D3DSAMP_MINFILTER, &MinFilter);
+	(*d3d9Device)->GetSamplerState(0, D3DSAMP_MAGFILTER, &MagFilter);
+	(*d3d9Device)->GetSamplerState(0, D3DSAMP_MIPFILTER, &MipFilter);
+
+	m_IDirectDrawSurfaceX* Texture = CurrentTextureSurfaceX[0];
+	const bool ColorKey = Texture && Texture->IsColorKeyTexture();
+	const bool HasAlpha = Texture && Texture->HasAlphaChannel(ColorKey);
+	if (!AlphaBlend && !AlphaTest && !ColorKey && !HasAlpha)
+	{
+		return;
+	}
+
+	DWORD MinVertexAlpha = 0xFF;
+	DWORD MaxVertexAlpha = 0;
+	DWORD FirstDiffuse = 0;
+	bool HasVertexAlpha = false;
+	float MinVertexX = FLT_MAX;
+	float MinVertexY = FLT_MAX;
+	float MaxVertexX = -FLT_MAX;
+	float MaxVertexY = -FLT_MAX;
+	bool HasScreenPosition = false;
+	if (Vertices && VertexCount && (VertexTypeDesc & D3DFVF_XYZRHW))
+	{
+		const DWORD Stride = GetVertexStride(VertexTypeDesc);
+		for (DWORD i = 0; i < VertexCount; ++i)
+		{
+			const float* Position = reinterpret_cast<const float*>(reinterpret_cast<const BYTE*>(Vertices) + (i * Stride));
+			MinVertexX = min(MinVertexX, Position[0]);
+			MinVertexY = min(MinVertexY, Position[1]);
+			MaxVertexX = max(MaxVertexX, Position[0]);
+			MaxVertexY = max(MaxVertexY, Position[1]);
+		}
+		HasScreenPosition = true;
+	}
+	if (Vertices && VertexCount && (VertexTypeDesc & D3DFVF_DIFFUSE))
+	{
+		DWORD DiffuseOffset = 0;
+		switch (VertexTypeDesc & D3DFVF_POSITION_MASK)
+		{
+		case D3DFVF_XYZ: DiffuseOffset = 3 * sizeof(float); break;
+		case D3DFVF_XYZRHW: DiffuseOffset = 4 * sizeof(float); break;
+		case D3DFVF_XYZB1: DiffuseOffset = 4 * sizeof(float); break;
+		case D3DFVF_XYZB2: DiffuseOffset = 5 * sizeof(float); break;
+		case D3DFVF_XYZB3: DiffuseOffset = 6 * sizeof(float); break;
+		case D3DFVF_XYZB4: DiffuseOffset = 7 * sizeof(float); break;
+		case D3DFVF_XYZB5: DiffuseOffset = 8 * sizeof(float); break;
+		default: DiffuseOffset = 0; break;
+		}
+		if (DiffuseOffset)
+		{
+			if (VertexTypeDesc & D3DFVF_NORMAL)
+			{
+				DiffuseOffset += 3 * sizeof(float);
+			}
+			const DWORD Stride = GetVertexStride(VertexTypeDesc);
+			for (DWORD i = 0; i < VertexCount; ++i)
+			{
+				const DWORD Diffuse = *reinterpret_cast<const DWORD*>(reinterpret_cast<const BYTE*>(Vertices) + (i * Stride) + DiffuseOffset);
+				if (i == 0)
+				{
+					FirstDiffuse = Diffuse;
+				}
+				const DWORD Alpha = Diffuse >> 24;
+				MinVertexAlpha = min(MinVertexAlpha, Alpha);
+				MaxVertexAlpha = max(MaxVertexAlpha, Alpha);
+			}
+			HasVertexAlpha = true;
+		}
+	}
+
+	const UINT64 TextureId = reinterpret_cast<UINT_PTR>(Texture);
+	if (AlphaBlend && Texture)
+	{
+		static std::vector<UINT64> DumpedTextures;
+		if (std::find(DumpedTextures.begin(), DumpedTextures.end(), TextureId) == DumpedTextures.end())
+		{
+			DumpedTextures.push_back(TextureId);
+			if (IDirect3DTexture9* DrawTexture = Texture->GetD9DrawTexture(); DrawTexture && D3DXSaveTextureToFileInMemory)
+			{
+				char ExePath[MAX_PATH] = {};
+				if (GetModuleFileNameA(nullptr, ExePath, MAX_PATH))
+				{
+					if (char* Slash = strrchr(ExePath, '\\'))
+					{
+						*Slash = '\0';
+					}
+					char DumpDirectory[MAX_PATH] = {};
+					sprintf_s(DumpDirectory, "%s\\alpha-trace-textures", ExePath);
+					CreateDirectoryA(DumpDirectory, nullptr);
+
+					char DumpPath[MAX_PATH] = {};
+					sprintf_s(DumpPath, "%s\\tex-%08llX-%lux%lu-src%lu-dst%lu.png", DumpDirectory,
+						TextureId, Texture->GetD9Width(), Texture->GetD9Height(), SrcBlend, DestBlend);
+
+					ComPtr<ID3DXBuffer> Buffer;
+					const HRESULT DumpResult = D3DXSaveTextureToFileInMemory(Buffer.GetAddressOf(), D3DXIFF_PNG, DrawTexture, nullptr);
+					if (SUCCEEDED(DumpResult) && Buffer)
+					{
+						std::ofstream Output(DumpPath, std::ios::binary | std::ios::out);
+						if (Output.is_open())
+						{
+							Output.write(static_cast<const char*>(Buffer->GetBufferPointer()), Buffer->GetBufferSize());
+						}
+					}
+					Logging::Log() << "AlphaTrace texture dump tex=" << Texture << " path=" << DumpPath << " hr=" << (D3DERR)DumpResult;
+				}
+			}
+		}
+	}
+
+	UINT64 Signature = TextureId ^ (static_cast<UINT64>(PrimitiveType) << 48) ^ (static_cast<UINT64>(VertexTypeDesc) << 24) ^ VertexCount;
+	Signature ^= (static_cast<UINT64>(AlphaBlend) << 63) ^ (static_cast<UINT64>(SrcBlend) << 56) ^ (static_cast<UINT64>(DestBlend) << 52);
+	Signature ^= (static_cast<UINT64>(AlphaTest) << 51) ^ (static_cast<UINT64>(AlphaOp) << 44) ^ (static_cast<UINT64>(ColorOp) << 36);
+	Signature ^= (static_cast<UINT64>(MinVertexAlpha) << 8) ^ MaxVertexAlpha;
+	Signature ^= FirstDiffuse;
+	if (HasScreenPosition)
+	{
+		Signature ^= static_cast<UINT64>(static_cast<LONG>(MinVertexX)) << 32;
+		Signature ^= static_cast<UINT64>(static_cast<LONG>(MinVertexY));
+	}
+
+	static std::vector<UINT64> SeenSignatures;
+	if (SeenSignatures.size() >= 1024 || std::find(SeenSignatures.begin(), SeenSignatures.end(), Signature) != SeenSignatures.end())
+	{
+		return;
+	}
+	SeenSignatures.push_back(Signature);
+
+	Logging::Log() << "AlphaTrace " << DrawKind <<
+		" prim=" << PrimitiveType << " fvf=" << Logging::hex(VertexTypeDesc) << " verts=" << VertexCount <<
+		" tex=" << Texture << " size=" << (Texture ? Texture->GetD9Width() : 0) << "x" << (Texture ? Texture->GetD9Height() : 0) <<
+		" fmt=" << (Texture ? Texture->GetSurfaceFormat() : D3DFMT_UNKNOWN) << " ckey=" << ColorKey << " texAlpha=" << HasAlpha <<
+		" blend=" << AlphaBlend << " src=" << SrcBlend << " dst=" << DestBlend <<
+		" atest=" << AlphaTest << " afunc=" << AlphaFunc << " aref=" << AlphaRef <<
+		" colorOp=" << ColorOp << " alphaOp=" << AlphaOp <<
+		" min=" << MinFilter << " mag=" << MagFilter << " mip=" << MipFilter <<
+		" z=" << ZEnable << " zwrite=" << ZWrite <<
+		" va=" << (HasVertexAlpha ? static_cast<LONG>(MinVertexAlpha) : -1) << "-" << (HasVertexAlpha ? static_cast<LONG>(MaxVertexAlpha) : -1) <<
+		" diffuse=" << Logging::hex(FirstDiffuse) <<
+		" xy=" << (HasScreenPosition ? MinVertexX : -1.0f) << "," << (HasScreenPosition ? MinVertexY : -1.0f) << "-" <<
+		(HasScreenPosition ? MaxVertexX : -1.0f) << "," << (HasScreenPosition ? MaxVertexY : -1.0f);
+}
