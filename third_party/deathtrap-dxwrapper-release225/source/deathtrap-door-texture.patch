+#pragma once
+
+#include <cmath>
+
+namespace DeathtrapDoorTexture
+{
+	constexpr unsigned MaxVertices = 8;
+	constexpr double TileEnd = 63.0 / 64.0;
+
+	struct Point
+	{
+		double X, Y;
+		Point operator-(const Point& Other) const { return {X - Other.X, Y - Other.Y}; }
+	};
+
+	inline double Cross(Point A, Point B) { return A.X * B.Y - A.Y * B.X; }
+
+	struct Vertex
+	{
+		float X, Y, RHW, U, V;
+	};
+
+	struct ProjectedUV
+	{
+		float U, V, Q;
+	};
+
+	// Inversion, BOX level resource 9197. In units of the upper edge,
+	// the lower edge starts at 436/1200 and is 530/1200 wide.
+	// The second lintel using this tile starts at 225/1200 with width 750/1200.
+	struct Shape { double Offset, Width; };
+	constexpr Shape Lintels[] = {{436.0 / 1200.0, 530.0 / 1200.0}, {225.0 / 1200.0, 750.0 / 1200.0}};
+
+	inline bool Project(const Vertex* Vertices, unsigned Count, Shape Lintel, ProjectedUV* Result)
+	{
+		if (Count < 4 || Count > MaxVertices)
+		{
+			return false;
+		}
+
+		Point World[MaxVertices];
+		Point Panel[MaxVertices];
+		bool OnEdge[MaxVertices];
+		const double ReferenceRHW = Vertices[0].RHW;
+		for (unsigned i = 0; i < Count; ++i)
+		{
+			const auto& Vertex = Vertices[i];
+			const double U = Vertex.U / TileEnd, V = Vertex.V / TileEnd;
+			if (!(Vertex.RHW > 0.0f && Vertex.RHW < 0.1f &&
+				U >= -0.0001 && U <= 1.0001 && V >= -0.0001 && V <= 1.0001))
+			{
+				return false;
+			}
+			// Undo the perspective divide. Any two independent screen axes can
+			// describe the panel after this step; actual focal length is irrelevant.
+			const double DepthRatio = ReferenceRHW / Vertex.RHW;
+			World[i] = {DepthRatio * (Vertex.X - Vertices[0].X), DepthRatio * (Vertex.Y - Vertices[0].Y)};
+			Panel[i] = {Lintel.Offset * V + U * (1.0 + (Lintel.Width - 1.0) * V), V};
+			OnEdge[i] = std::abs(U) < 0.0001 || std::abs(U - 1.0) < 0.0001 ||
+				std::abs(V) < 0.0001 || std::abs(V - 1.0) < 0.0001;
+		}
+
+		// Native clipping preserves the original UV on the panel perimeter.
+		// At a viewport corner both UV axes can be interpolated by the old fan.
+		// Fit to perimeter vertices, then recover any interior UV from its position.
+		unsigned A = 0, B = 0, C = 0;
+		double BestArea = 0.0;
+		unsigned EdgeCount = 0;
+		for (unsigned i = 0; i < Count; ++i)
+		{
+			if (!OnEdge[i]) continue;
+			++EdgeCount;
+			for (unsigned j = i + 1; j < Count; ++j)
+			{
+				if (!OnEdge[j]) continue;
+				for (unsigned k = j + 1; k < Count; ++k)
+				{
+					if (!OnEdge[k]) continue;
+					const double Area = std::abs(Cross(Panel[j] - Panel[i], Panel[k] - Panel[i]));
+					if (Area > BestArea)
+					{
+						BestArea = Area;
+						A = i;
+						B = j;
+						C = k;
+					}
+				}
+			}
+		}
+		if (EdgeCount < 3 || BestArea < 0.0001) return false;
+
+		const Point AB = World[B] - World[A], AC = World[C] - World[A];
+		const Point UVB = Panel[B] - Panel[A], UVC = Panel[C] - Panel[A];
+		const double Area = Cross(AB, AC);
+		if (std::abs(Area) < 0.001) return false;
+
+		for (unsigned i = 0; i < Count; ++i)
+		{
+			const Point P = World[i] - World[A];
+			const double S = Cross(P, AC) / Area;
+			const double T = Cross(AB, P) / Area;
+			const double X = Panel[A].X + S * UVB.X + T * UVC.X;
+			const double V = Panel[A].Y + S * UVB.Y + T * UVC.Y;
+			const double Q = 1.0 + (Lintel.Width - 1.0) * V;
+			const double U = (X - Lintel.Offset * V) / Q;
+			const double ProjectedV = Lintel.Width * V / Q;
+			if (!(Q > 0 && U >= -0.01 && U <= 1.01 && ProjectedV >= -0.01 && ProjectedV <= 1.01) ||
+				(OnEdge[i] && (std::abs(X - Panel[i].X) > 0.005 || std::abs(V - Panel[i].Y) > 0.005)))
+			{
+				return false;
+			}
+			Result[i] = {static_cast<float>(TileEnd * (X - Lintel.Offset * V)),
+				static_cast<float>(TileEnd * Lintel.Width * V), static_cast<float>(Q)};
+		}
+		return true;
+	}
