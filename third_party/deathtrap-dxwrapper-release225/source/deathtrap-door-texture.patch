+static bool IsDeathtrapSkullTexture(IDirect3DDevice9* Device, m_IDirectDrawSurfaceX* Surface)
+{
+	if (!Surface || Surface->GetD9Width() != 64 || Surface->GetD9Height() != 64)
+	{
+		return false;
+	}
+
+	DWORD Revision = 0;
+	Surface->GetUniquenessValue(&Revision, 0);
+	ComPtr<IDirect3DBaseTexture9> Bound;
+	if (FAILED(Device->GetTexture(0, Bound.GetAddressOf())) ||
+		!Bound || Bound->GetType() != D3DRTYPE_TEXTURE)
+	{
+		return false;
+	}
+	auto* Texture = static_cast<IDirect3DTexture9*>(Bound.Get());
+	SkullTextureTag Cached = {};
+	DWORD Size = sizeof(Cached);
+	if (Revision && SUCCEEDED(Texture->GetPrivateData(SkullTextureData, &Cached, &Size)) &&
+		Size == sizeof(Cached) && Cached.Revision == Revision)
+	{
+		return Cached.IsSkull != FALSE;
+	}
+
+	D3DSURFACE_DESC Description = {};
+	if (FAILED(Texture->GetLevelDesc(0, &Description)) || Description.Width != 64 || Description.Height != 64)
+	{
+		return false;
+	}
+	const bool RGB565 = Description.Format == D3DFMT_R5G6B5;
+	const bool RGB555 = Description.Format == D3DFMT_X1R5G5B5 || Description.Format == D3DFMT_A1R5G5B5;
+	const bool RGB32 = Description.Format == D3DFMT_X8R8G8B8 || Description.Format == D3DFMT_A8R8G8B8;
+	if (!RGB32 && !RGB565 && !RGB555)
+	{
+		return false;
+	}
+
+	D3DLOCKED_RECT Locked = {};
+	if (FAILED(Texture->LockRect(0, &Locked, nullptr, D3DLOCK_READONLY)))
+	{
+		return false;
+	}
+	bool IsSkull = true;
+	for (const auto& Sample : SkullTexels)
+	{
+		const auto* Row = static_cast<const BYTE*>(Locked.pBits) + Sample.Y * Locked.Pitch;
+		if (RGB32)
+		{
+			const auto* BGR = Row + Sample.X * 4;
+			IsSkull = NearSkullColor(Sample, BGR[2], BGR[1], BGR[0]);
+		}
+		else
+		{
+			const WORD Color = reinterpret_cast<const WORD*>(Row)[Sample.X];
+			const DWORD Red = (Color >> (RGB565 ? 11 : 10)) & 31;
+			const DWORD Green = (Color >> 5) & (RGB565 ? 63 : 31);
+			const DWORD Blue = Color & 31;
+			IsSkull = NearSkullColor(Sample, Red * 255 / 31, Green * 255 / (RGB565 ? 63 : 31), Blue * 255 / 31);
+		}
+		if (!IsSkull) break;
+	}
+	Texture->UnlockRect(0);
+
+	if (Revision)
+	{
+		const SkullTextureTag Tag = {Revision, IsSkull};
+		Texture->SetPrivateData(SkullTextureData, &Tag, sizeof(Tag), 0);
+	}
+	return IsSkull;
+}
+
+static bool DrawDeathtrapSkull(IDirect3DDevice9* Device, m_IDirectDrawSurfaceX* Surface,
+	D3DPRIMITIVETYPE Primitive, DWORD FVF,
+	const void* Vertices, DWORD Count, HRESULT& Result)
+{
+	using namespace DeathtrapDoorTexture;
+	if (Primitive != D3DPT_TRIANGLEFAN || FVF != D3DFVF_TLVERTEX ||
+		Count < 4 || Count > MaxVertices || !IsDeathtrapWidescreenWorldRenderActive() ||
+		!IsDeathtrapSkullTexture(Device, Surface))
+	{
+		return false;
+	}
+
+	DWORD Transform = 0, Wrap = 0, TexCoordIndex = 0;
+	if (FAILED(Device->GetTextureStageState(0, D3DTSS_TEXTURETRANSFORMFLAGS, &Transform)) ||
+		FAILED(Device->GetTextureStageState(0, D3DTSS_TEXCOORDINDEX, &TexCoordIndex)) ||
+		FAILED(Device->GetRenderState(D3DRS_WRAP0, &Wrap)) || Transform || TexCoordIndex || Wrap)
+	{
+		return false;
+	}
+
+	const auto* Input = static_cast<const D3DTLVERTEX*>(Vertices);
+	Vertex Source[MaxVertices];
+	for (DWORD i = 0; i < Count; ++i)
+	{
+		Source[i] = {Input[i].sx, Input[i].sy, Input[i].rhw, Input[i].tu, Input[i].tv};
+	}
+	ProjectedUV UV[MaxVertices];
+	bool Projected = false;
+	for (const auto& Lintel : Lintels)
+	{
+		if (Project(Source, Count, Lintel, UV))
+		{
+			Projected = true;
+			break;
+		}
+	}
+	if (!Projected)
+	{
+		return false;
+	}
+
+	struct ProjectedVertex
+	{
+		D3DTLVERTEX Base;
+		float Q;
+	};
+	ProjectedVertex Output[MaxVertices];
+	for (DWORD i = 0; i < Count; ++i)
+	{
+		Output[i] = {Input[i], UV[i].Q};
+		Output[i].Base.tu = UV[i].U;
+		Output[i].Base.tv = UV[i].V;
+	}
+	if (FAILED(Device->SetFVF(FVF | D3DFVF_TEXCOORDSIZE3(0))))
+	{
+		return false;
+	}
+	if (FAILED(Device->SetTextureStageState(0, D3DTSS_TEXTURETRANSFORMFLAGS, D3DTTFF_COUNT3 | D3DTTFF_PROJECTED)))
+	{
+		Device->SetFVF(FVF);
+		return false;
+	}
+	Result = Device->DrawPrimitiveUP(Primitive, Count - 2, Output, sizeof(ProjectedVertex));
+	Device->SetTextureStageState(0, D3DTSS_TEXTURETRANSFORMFLAGS, Transform);
+	Device->SetFVF(FVF);
+	return SUCCEEDED(Result);
+}
