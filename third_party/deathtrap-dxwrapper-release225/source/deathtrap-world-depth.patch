+m_IDirect3DDeviceX::DeathtrapDepthDraw::~DeathtrapDepthDraw()
+{
+	if (!Active)
+	{
+		return;
+	}
+	Device->SetRenderState(D3DRS_ZENABLE, D3DZB_FALSE);
+	Device->SetRenderState(D3DRS_ZWRITEENABLE, PreviousWrite);
+	Device->SetRenderState(D3DRS_ZFUNC, PreviousFunc);
+	Device->SetDepthStencilSurface(PreviousSurface.Get());
+}
+
+void m_IDirect3DDeviceX::ResetDeathtrapDepth()
+{
+	DeathtrapDepthSurface.Reset();
+	DeathtrapDepthTarget = nullptr;
+	DeathtrapDepthWidth = DeathtrapDepthHeight = 0;
+	DeathtrapDepthNeedsClear = true;
+	DeathtrapDepthUnavailable = false;
+}
+
+void m_IDirect3DDeviceX::PrepareDeathtrapDepthDraw(DeathtrapDepthDraw& Depth, DWORD VertexType, LPVOID Vertices, DWORD Count)
+{
+	if (!IsInScene ||
+		!lpCurrentRenderTargetX || !Count || Vertices != VertexCache.data() || VertexType != D3DFVF_TLVERTEX ||
+		DeviceStates.RenderState[D3DRS_ZENABLE].State != D3DZB_FALSE ||
+		!IsDeathtrapWidescreenWorldRenderActive())
+	{
+		return;
+	}
+
+	// Retail supplies positive camera-space depth as 1/RHW on its 3D draws.
+	// Pre-projected screen quads use a common 1.0 W and keep their retail order.
+	constexpr float NearZ = 32.0f;
+	const auto* Input = static_cast<const D3DTLVERTEX*>(Vertices);
+	for (DWORD i = 0; i < Count; ++i)
+	{
+		const float RHW = Input[i].rhw;
+		if (!std::isfinite(RHW) || RHW <= 0.0f || RHW > 1.0f / NearZ)
+		{
+			return;
+		}
+	}
+
+	const DWORD Width = lpCurrentRenderTargetX->GetD9Width();
+	const DWORD Height = lpCurrentRenderTargetX->GetD9Height();
+	if (DeathtrapDepthTarget != lpCurrentRenderTargetX || DeathtrapDepthWidth != Width || DeathtrapDepthHeight != Height)
+	{
+		ResetDeathtrapDepth();
+		DeathtrapDepthTarget = lpCurrentRenderTargetX;
+		DeathtrapDepthWidth = Width;
+		DeathtrapDepthHeight = Height;
+	}
+	if (DeathtrapDepthUnavailable)
+	{
+		return;
+	}
+
+	const auto Device = Depth.Device;
+	if (!DeathtrapDepthSurface.Get())
+	{
+		ComPtr<IDirect3DSurface9> Target;
+		D3DSURFACE_DESC Desc = {};
+		if (FAILED(Device->GetRenderTarget(0, Target.GetAddressOf())) ||
+			FAILED(Target->GetDesc(&Desc)) ||
+			FAILED(Device->CreateDepthStencilSurface(Desc.Width, Desc.Height, D3DFMT_D24X8,
+				Desc.MultiSampleType, Desc.MultiSampleQuality, FALSE, DeathtrapDepthSurface.GetAddressOf(), nullptr)))
+		{
+			DeathtrapDepthUnavailable = true;
+			LOG_LIMIT(5, "DeathtrapWorldDepth depth surface unavailable");
+			return;
+		}
+		LOG_LIMIT(10, "DeathtrapWorldDepth ready " << Desc.Width << "x" << Desc.Height);
+	}
+
+	Device->GetDepthStencilSurface(Depth.PreviousSurface.GetAddressOf());
+	Device->GetRenderState(D3DRS_ZWRITEENABLE, &Depth.PreviousWrite);
+	Device->GetRenderState(D3DRS_ZFUNC, &Depth.PreviousFunc);
+	if (FAILED(Device->SetDepthStencilSurface(DeathtrapDepthSurface.Get())))
+	{
+		DeathtrapDepthUnavailable = true;
+		LOG_LIMIT(5, "DeathtrapWorldDepth depth surface bind failed");
+		return;
+	}
+	Depth.Active = true;
+	if (DeathtrapDepthNeedsClear)
+	{
+		if (FAILED(Device->Clear(0, nullptr, D3DCLEAR_ZBUFFER, 0, 1.0f, 0)))
+		{
+			DeathtrapDepthUnavailable = true;
+			LOG_LIMIT(5, "DeathtrapWorldDepth depth clear failed");
+			return;
+		}
+		DeathtrapDepthNeedsClear = false;
+	}
+
+	const bool Blending = DeviceStates.RenderState[D3DRS_ALPHABLENDENABLE].State != FALSE;
+	if (FAILED(Device->SetRenderState(D3DRS_ZFUNC, D3DCMP_LESSEQUAL)) ||
+		FAILED(Device->SetRenderState(D3DRS_ZWRITEENABLE, !Blending)) ||
+		FAILED(Device->SetRenderState(D3DRS_ZENABLE, D3DZB_TRUE)))
+	{
+		DeathtrapDepthUnavailable = true;
+		return;
+	}
+	auto* Output = static_cast<D3DTLVERTEX*>(Vertices);
+	for (DWORD i = 0; i < Count; ++i)
+	{
+		Output[i].sz = 1.0f - NearZ * Output[i].rhw;
+	}
+}
