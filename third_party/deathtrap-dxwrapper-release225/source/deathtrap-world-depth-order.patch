+static bool DrawDeathtrapWorldQuad(IDirect3DDevice9* Device, DWORD FVF,
+	const D3DTLVERTEX* Input, const float (*UVQ)[3], DWORD Count, HRESULT& Result)
+{
+	DWORD Transform = 0, Wrap = 0, TexCoordIndex = 0;
+	if (FAILED(Device->GetTextureStageState(0, D3DTSS_TEXTURETRANSFORMFLAGS, &Transform)) ||
+		FAILED(Device->GetTextureStageState(0, D3DTSS_TEXCOORDINDEX, &TexCoordIndex)) ||
+		FAILED(Device->GetRenderState(D3DRS_WRAP0, &Wrap)) || Transform || TexCoordIndex || Wrap)
+	{
+		return false;
+	}
+
+	struct ProjectedVertex
+	{
+		D3DTLVERTEX Base;
+		float Q;
+	};
+	ProjectedVertex Output[9];
+	for (DWORD i = 0; i < Count; ++i)
+	{
+		Output[i] = {Input[i], UVQ[i][2]};
+		Output[i].Base.tu = UVQ[i][0];
+		Output[i].Base.tv = UVQ[i][1];
+	}
+	if (FAILED(Device->SetFVF(FVF | D3DFVF_TEXCOORDSIZE3(0))))
+	{
+		return false;
+	}
+	if (FAILED(Device->SetTextureStageState(0, D3DTSS_TEXTURETRANSFORMFLAGS, D3DTTFF_COUNT3 | D3DTTFF_PROJECTED)))
+	{
+		Device->SetFVF(FVF);
+		return false;
+	}
+	Result = Device->DrawPrimitiveUP(D3DPT_TRIANGLEFAN, Count - 2, Output, sizeof(ProjectedVertex));
+	Device->SetTextureStageState(0, D3DTSS_TEXTURETRANSFORMFLAGS, Transform);
+	Device->SetFVF(FVF);
+	return SUCCEEDED(Result);
+}
+
+static bool GetDeathtrapWorldQuad(const void* Vertices, DWORD Count, float* UVQ)
+{
+	using ProjectQuad = BOOL(WINAPI*)(const void*, DWORD, float*);
+	static ProjectQuad Project = nullptr;
+	if (!Project)
+	{
+		if (HMODULE Dinput = GetModuleHandleW(L"DINPUT.dll"))
+		{
+			Project = reinterpret_cast<ProjectQuad>(GetProcAddress(Dinput, "DeathtrapProjectWorldQuad"));
+		}
+	}
+	return Project && Project(Vertices, Count, UVQ);
+}
